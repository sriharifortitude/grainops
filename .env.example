# Copy to .env. Nothing in this file is secret until you fill it in.
POSTGRES_PASSWORD=change-me
GRAFANA_ADMIN_PASSWORD=change-me
# Ports on the host.
PUBLIC_PORT=8080
GRAFANA_PORT=3000
PROMETHEUS_PORT=9090
# Raw events older than this are dropped by the worker, one month at a time.
RETENTION_MONTHS=13
# Pinned application versions (git tags in each repository).
EVENTGRAIN_VERSION=v0.1.2
GRAINVIEW_VERSION=v0.1.3
GATELIMIT_VERSION=v0.1.1
TABLEWARDEN_VERSION=v0.1.0
